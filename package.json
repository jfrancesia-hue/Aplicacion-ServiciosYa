{
  "name": "apptrabajo",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "emu": "expo run:android --device 127.0.0.1:5555",
    "build:android:internal": "eas build --platform android --profile internal",
    "submit:android:internal": "eas submit --platform android --profile internal",
    "check:internal-release-env": "node scripts/check_internal_release_env.js",
    "db:lint": "supabase db lint --linked --schema public,private --level warning",
    "eas-build-pre-install": "node scripts/check_internal_release_env.js",
    "check:serviciosya-contract": "node scripts/check_serviciosya_unified_contract.js",
    "legal:export-public": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/export_public_legal_documents.mjs",
    "legal:check-public": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/export_public_legal_documents.mjs --check",
    "bundle:android:check": "expo export --platform android --output-dir dist/qa-android",
    "qa:release": "npm run typecheck && npm run lint && npm test && npm run check:serviciosya-contract && npm run legal:check-public && npm audit --omit=dev --audit-level=high && npx expo-doctor && npm run bundle:android:check",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/*.test.mjs"
  },
