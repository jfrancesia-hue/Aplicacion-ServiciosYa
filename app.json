{
  "expo": {
    "name": "Servicios Ya",
    "slug": "appTrabajo",
    "scheme": "solucionesya",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "version": "96.0.0",
    "orientation": "portrait",
    "icon": "./assets/serviciosya-logo-2026.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/serviciosya-logo-2026.png",
      "resizeMode": "contain",
      "backgroundColor": "#20231f"
    },
    "assetBundlePatterns": [
      "assets/icon.png",
      "assets/splash-icon.png",
      "assets/adaptive-icon.png",
      "assets/serviciosya-logo-2026.png",
      "assets/favicon.png",
      "assets/sounds/*"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "ios": {
      "buildNumber": "96",
      "associatedDomains": [
        "applinks:serviciosya.site"
      ],
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Esta app utiliza tu ubicación para mostrar trabajadores o proveedores de servicios cercanos, como plomeros o electricistas, y ayudarte a recibir asistencia más rápido y eficiente en tu zona.",
        "NSUserNotificationsUsageDescription": "Esta app necesita enviarte notificaciones para alertarte cuando recibas un mensaje nuevo o cuando tu servicio haya sido contratado, manteniéndote informado sobre las actualizaciones importantes.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "solucionesya",
              "com.googleusercontent.apps.453761258131-6anu4ghpi4jv1df72490vo69vj23qq22"
            ]
          }
        ]
      },
      "bundleIdentifier": "com.alex-6775.appTrabajo",
      "appleTeamId": "HHY5MJ22J3"
    },
    "android": {
      "versionCode": 96,
      "adaptiveIcon": {
        "foregroundImage": "./assets/serviciosya-logo-2026.png",
        "backgroundColor": "#20231f"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.alex_6775.appTrabajo",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "serviciosya.site",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "serviciosya.site",
              "pathPrefix": "/completar-perfil"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "solucionesya"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/serviciosya-logo-2026.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/urgent_work.wav"
          ]
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      "@maplibre/maplibre-react-native",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.453761258131-6anu4ghpi4jv1df72490vo69vj23qq22"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#20231f",
          "image": "./assets/serviciosya-logo-2026.png",
          "imageWidth": 240
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permitir que $(PRODUCT_NAME) acceda a tu ubicación en todo momento para mostrarte trabajadores o proveedores de servicios cercanos y ayudarte a recibir asistencia más rápida y eficiente en tu zona."
        }
      ],
      "react-native-edge-to-edge",
      [
        "expo-maps",
        {
          "requestLocationPermission": true,
          "locationPermission": "Permitir que $(PRODUCT_NAME) utilice tu ubicación para mostrar trabajadores o proveedores de servicios cercanos, como plomeros o electricistas, y ayudarte a recibir asistencia más rápido y eficiente en tu zona."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir acceso a tu galería para subir imágenes en la aplicación.",
          "cameraPermission": "Esta app necesita acceder a tu cámara exclusivamente para tomar una foto de tu cara y usarla como foto de perfil dentro de la aplicación."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Permitir que Servicios Ya use tu micrófono para grabar y enviar mensajes de voz en el chat interno."
        }
      ],
      "expo-web-browser",
      "expo-asset",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "extra": {
      "serviciosYaSyncBaseUrl": "https://serviciosya.site",
      "serviciosYaAppSyncToken": "",
      "serviciosYaBridge": {
        "baseUrl": "https://serviciosya.site/api/app"
      },
      "eas": {
        "projectId": "aea4aff9-1e66-4a9c-a2e7-17402b7bc1f1"
      },
      "router": {
        "entry": "./expo-router-entry.js"
      }
    },
    "owner": "perezzz2003"
  }
}
