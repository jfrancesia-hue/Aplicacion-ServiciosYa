# Copy everything from your .gitignore file here
# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.der
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
*.log
expo-web.*.log

# macOS
.DS_Store
*.pem

# local env files
.env
.env.*
.env*.local

# typescript
*.tsbuildinfo
# Ignore files and directories that EAS Build doesn't need to build your app
/docs
/website

# EAS usa Continuous Native Generation; toda opción nativa necesaria debe
# estar declarada en app.json/config plugins.
/android
/ios

# Ignore test coverage reports
/coverage

# Supabase local state
/supabase/.temp

# Local working folders, credentials and build artifacts
/.omc
/.tmp
/_BACKUP_*
/_FIXES
/_seguridad_paso*
/credentials.json
/credentials
/builds
/android/keystore.properties
/android/keystore.properties.*
