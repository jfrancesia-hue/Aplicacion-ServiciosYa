# Copy everything from your .gitignore file here
# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p|
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo
# Ignore files and directories that EAS Build doesn't need to build your app
/docs
/website

# EAS usa Continuous Native Generation; toda opción nativa necesaria debe
# estar declarada en app.json/config plugins.
/android
/ios

# Ignore test coverage reports
/coverage
